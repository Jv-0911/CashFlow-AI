# Copy to .env privately. Never commit populated environment files.
# Blank administrator password gives a read-only fictional demo on localhost.
CASHFLOW_ADMIN_PASSWORD=
CASHFLOW_PUBLIC_ORIGIN=http://127.0.0.1:8000
# For split hosting: exact backend DNS hostname, without scheme or path.
CASHFLOW_BACKEND_HOST=
LEDGER_DB_PATH=./data/ledger.db

# Payment calls are explicitly disabled until configured and enabled.
CASHFLOW_PAYPAL_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_PAYER_EMAIL=
PAYPAL_HTTP_TIMEOUT_SECONDS=10
PAYMENTS_MAX_INVOICE_CENTS=1000000
PAYMENTS_ALLOWED_CURRENCIES=USD

# Optional AI ranking/explanations. Deterministic analysis works without it.
CASHFLOW_AI_ENABLED=false
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=15
